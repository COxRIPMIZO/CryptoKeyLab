{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CryptokeyLab;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "ResetWorkerSettings": {
    "NoOfDataToFetch": 100,
    "KeyStatus": true,
    "ApiKeyMaxUsageCount": 5,
    "ServiceStartDelay": "1M", //Add H hours e.g 1H , M for minutes  e.g 1M, S for seconds e.g 1S, ms for miliseconds e.g 1ms
    "ServiceStopDelay": "1M" //Add H hours e.g 1H , M for minutes  e.g 1M, S for seconds e.g 1S, ms for miliseconds e.g 1ms
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": {
            "type": "Serilog.Formatting.Json.JsonFormatter, Serilog"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "MyCoolApp"
    }
  }
}
