{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CryptokeyLab;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "ApiSettings": {
    "ApiKeyHeaderName": "X-API-KEY"
  },
  "CacheSettings": {
    "Provider": "InMemory", // Change this to "Redis" when you launch to production!
    "RedisConnectionString": "localhost:6379"
  }
}
